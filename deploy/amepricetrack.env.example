# Settings for the AmePriceTrack service. Installed as /etc/amepricetrack.env.
# Every line is optional; the value shown is the default unless noted.
# After changing this file: sudo systemctl restart amepricetrack

# Address and port the website listens on.
#APT_BIND=0.0.0.0:8787

# How people reach this server. Used for the links inside alerts.
# No default; without it alerts link to the store's product page instead.
#APT_PUBLIC_URL=http://192.168.1.20:8787

# Minutes between price checks of each product (15 to 10080).
#APT_CHECK_INTERVAL_MINUTES=240

# Chrome or Chromium used for Staples, Best Buy, Kohl's and Harbor Freight.
# Found automatically when installed. Set a path to choose one, or "off" to
# never start a browser.
#APT_BROWSER=/usr/bin/google-chrome-stable

# Extra arguments passed to Chrome, separated by spaces.
#APT_BROWSER_ARGS=

# Number of the Target store whose prices are tracked (prices vary by store).
#APT_TARGET_STORE_ID=1375

# Set to 1 when the site is served over HTTPS (behind a reverse proxy), so
# sign-in cookies are only ever sent over HTTPS.
#APT_SECURE_COOKIES=0

# A copy of the database is written once a day; this many are kept. 0 turns
# backups off.
#APT_BACKUP_KEEP=14

# Where the daily copies go. The default is on the same disk as the data;
# another disk or a network folder also protects against losing that disk.
#APT_BACKUP_DIR=/var/lib/amepricetrack/backups

# Log detail: error, warn, info or debug.
#APT_LOG=info,sqlx=warn

# Folder where the last page that could not be read is saved, per store.
# Useful for seeing what a store actually sent when checks keep failing.
#APT_DEBUG_PAGES=/var/lib/amepricetrack/debug-pages
